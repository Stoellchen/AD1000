##########################################################################################
##
##  Gastromode in den Räumen ............. by usto
##
##########################################################################################

template:
  - unique_id: gastro_structure
    binary_sensor:
      - name: "Gastro Sensoren Gruppe"
        unique_id: gastro_sensoren_gruppe
        state: >-
          {% set gastro_entities = label_entities('GASTRO') | select('match', '^binary_sensor\.') | list %}
          {{ states.binary_sensor | selectattr('entity_id', 'in', gastro_entities) | selectattr('state', 'eq', 'on') | list | length > 0 }}
        attributes:
          all_sensors: >-
            {{ label_entities('GASTRO') | select('match', '^binary_sensor\.') | list }}

input_select:
  gastro_mode_guests:
    name: "Gastro-Modus Gästewahl"
    icon: mdi:account-group
    options:
      - "Nur wir"
      - "Schweizer Gäste"
      - "Französische Gäste"
      - "Gemischte Gäste"

  gastro_mode_quelle:
    name: "Gastro-Modus Audioquelle"
    icon: mdi:music-box-multiple
    options:
      - "Radio Stream"
      - "Lokale MP3-Ordner"

sensor:
  - platform: folder
    folder: /config/www/mp3/_gastromode/wir
  - platform: folder
    folder: /config/www/mp3/_gastromode/schweizer
  - platform: folder
    folder: /config/www/mp3/_gastromode/french
  - platform: folder
    folder: /config/www/mp3/_gastromode/mixed
  - platform: folder
    folder: /config/www/mp3/_gastromode/nacht

script:
  gastro_play_and_monitor:
    alias: "Gastro: Musik abspielen und überwachen (core_ha_gastromode)"
    description: "Spielt Musik basierend auf Quelle/Gästen und überwacht den Raum."
    mode: parallel
    max: 10
    
    sequence:
      # 1. INITIALISIERUNG
      - service: media_player.volume_set
        continue_on_error: true
        target:
          entity_id: "{{ ziel_speaker }}"
        data:
          volume_level: 0.01

      - choose:
          # WEICHE A: RADIO STREAM
          - conditions:
              - condition: template
                value_template: "{{ audio_quelle == 'Radio Stream' }}"
            sequence:
              - variables:
                  radio_url: >-
                    {% if now().hour >= 22 or now().hour < 6 %} https://radio4.vip-radios.fm:18054/stream-128kmp3-BuddhaBeach
                    {% elif gaeste_status == 'Nur wir' %} https://chmedia.streamabc.net/79-r24-mp3-192-6659699
                    {% elif gaeste_status == 'Schweizer Gäste' %} http://livestreaming-node-4.srg-ssr.ch/srgssr/rsp/mp3/128
                    {% elif gaeste_status == 'Französische Gäste' %} https://icecast.radiofrance.fr/fbchansonfrancaise-hifi.aac
                    {% else %} https://0nlineradio.stream13.radiohost.de/lounge-hotel-lounge {% endif %}

              - service: media_player.play_media
                continue_on_error: true
                target:
                  entity_id: "{{ ziel_speaker }}"
                data:
                  media_content_id: "{{ radio_url }}"
                  media_content_type: "music"

              - repeat:
                  count: 20
                  sequence:
                    - delay: "00:00:01"
                    - service: media_player.volume_set
                      continue_on_error: true
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: "{{ (0.01 + (repeat.index * ((ziel_volume - 0.01) / 20))) | round(2) }}"

              - repeat:
                  until:
                    - condition: template
                      value_template: "{{ is_state(ausloeser_entity, 'off') }}"
                  sequence:
                    - delay: "00:00:05"

          # WEICHE B: LOKALE MP3-PLAYLIST
          - conditions:
              - condition: template
                value_template: "{{ audio_quelle == 'Lokale MP3-Ordner' }}"
            sequence:
              - repeat:
                  until:
                    - condition: template
                      value_template: "{{ repeat.index >= 6 or is_state(ausloeser_entity, 'off') }}"
                  sequence:
                    - variables:
                        sensor_id: "sensor.{{ ordner }}"
                        songs: "{{ state_attr(sensor_id, 'file_list') }}"
                        zufalls_song: >-
                          {% if songs is not none and songs | length > 0 %}
                            {{ (songs | random).split('/') | last }}
                          {% else %}
                            none
                          {% endif %}
                        media_url: "http://10.231.9.100:8123/local/mp3/_gastromode/{{ ordner }}/{{ zufalls_song | urlencode }}"

                    - condition: template
                      value_template: "{{ zufalls_song != 'none' }}"

                    - service: media_player.play_media
                      continue_on_error: true
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        media_content_id: "{{ media_url }}"
                        media_content_type: "music"

                    - choose:
                        - conditions:
                            - condition: template
                              value_template: "{{ repeat.index == 1 }}"
                          sequence:
                            - repeat:
                                count: 20
                                sequence:
                                  - delay: "00:00:01"
                                  - service: media_player.volume_set
                                    continue_on_error: true
                                    target:
                                      entity_id: "{{ ziel_speaker }}"
                                    data:
                                      volume_level: "{{ (0.05 + (repeat.index * ((ziel_volume - 0.05) / 20))) | round(2) }}"
                      default:
                        - service: media_player.volume_set
                          continue_on_error: true
                          target:
                            entity_id: "{{ ziel_speaker }}"
                          data:
                            volume_level: "{{ ziel_volume }}"

                    - variables:
                        max_wartezeit: >-
                          {% set dur = state_attr(ziel_speaker, 'media_duration') | float(0) %}
                          {{ [dur - 2, 360] | min | int if dur > 5 else 180 }}
                    - repeat:
                        until:
                          - condition: template
                            value_template: "{{ (repeat.index * 5) >= max_wartezeit or is_state(ausloeser_entity, 'off') }}"
                        sequence:
                          - delay: "00:00:05"

      # ========================================================================
      # GEMEINSAMES SCHONZEIT- & AUSSCHALT-MANAGEMENT (Abfrage der letzten Bewegung)
      # ========================================================================
      - variables:
          # Wir prüfen, wann der Sensor das LETZTE MAL 'on' war (letzte Bewegung)
          letzte_bewegung: >-
            {% if is_state(ausloeser_entity, 'on') %}
              {{ now() }}
            {% else %}
              {{ states[ausloeser_entity].last_changed if states[ausloeser_entity] is defined else now() }}
            {% endif %}
          # Berechnen, wie viele Sekunden seit dieser letzten Bewegung vergangen sind
          sekunden_seit_bewegung: "{{ (as_timestamp(now()) - as_timestamp(letzte_bewegung)) | int(0) }}"
          # Wir wollen garantieren, dass das Radio erst 5 Minuten (300s) NACH der letzten Bewegung ausgeht
          rest_wartezeit: "{{ [300 - sekunden_seit_bewegung, 0] | max }}"

      # Wartezeit dynamisch absitzen (Format HH:MM:SS)
      - delay: >-
          {% if rest_wartezeit > 0 %}
            {% set hours = (rest_wartezeit // 3600) | int %}
            {% set minutes = ((rest_wartezeit % 3600) // 60) | int %}
            {% set seconds = (rest_wartezeit % 60) | int %}
            {{ "%02d:%02d:%02d" | format(hours, minutes, seconds) }}
          {% else %}
            00:00:01
          {% endif %}

      # Die fixe 10-Sekunden Gastro-Nachlaufzeit
      - delay: "00:00:10"
      
      - choose:
          # FALL 1: DAS WC IST IMMER NOCH LEER -> FADE-OUT UND AUSSCHALTEN
          - conditions:
              - condition: template
                value_template: "{{ is_state(ausloeser_entity, 'off') }}"
            sequence:
              - variables:
                  start_volume_fadeout: "{{ state_attr(ziel_speaker, 'volume_level') | default(0.35) | float }}"

              - repeat:
                  count: 30
                  sequence:
                    - condition: template
                      value_template: "{{ is_state(ausloeser_entity, 'off') }}"
                    - delay: "00:00:01"
                    - service: media_player.volume_set
                      continue_on_error: true
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: "{{ [start_volume_fadeout - (repeat.index * (start_volume_fadeout / 30)), 0.01] | max | round(2) }}"

              - choose:
                  - conditions:
                      - condition: template
                        value_template: "{{ is_state(ausloeser_entity, 'off') }}"
                    sequence:
                      - service: media_player.media_stop
                        continue_on_error: true
                        target:
                          entity_id: "{{ ziel_speaker }}"
                      - delay: "00:00:01"
                      - service: media_player.turn_off
                        continue_on_error: true
                        target:
                          entity_id: "{{ ziel_speaker }}"

          # FALL 2: JEMAND IST WIEDER REINGEKOMMEN! -> REBOOT (NAHTLOS)
          - conditions:
              - condition: template
                value_template: "{{ is_state(ausloeser_entity, 'on') }}"
            sequence:
              - service: script.gastro_play_and_monitor
                data:
                  ausloeser_entity: "{{ ausloeser_entity }}"
                  ziel_speaker: "{{ ziel_speaker }}"
                  ziel_volume: "{{ ziel_volume }}"
                  audio_quelle: "{{ audio_quelle }}"
                  ordner: "{{ ordner }}"
                  gaeste_status: "{{ gaeste_status }}"

automation:
- id: gastro_mode_trigger_script
  alias: "Gastro-Modus: Musik-Skript starten (core_ha_gastromode)"
  mode: parallel
  max: 10

  trigger:
    - platform: event
      event_type: state_changed

  condition:
    - condition: template
      value_template: >-
        {% set sensors = state_attr('binary_sensor.gastro_sensoren_gruppe', 'all_sensors') %}
        {{ trigger.event.data.entity_id is defined and sensors is not none and trigger.event.data.entity_id in sensors }}
    - condition: template
      value_template: "{{ trigger.event.data.new_state.state == 'on' and trigger.event.data.old_state.state != 'on' }}"

  action:
    - variables:
        ausloeser_entity: "{{ trigger.event.data.entity_id }}"
        ziel_raum: "{{ area_id(ausloeser_entity) }}"
        ziel_speaker: '{{ area_entities(ziel_raum) | select("match", "^media_player\.") | select("in", label_entities("GASTRO")) | first }}'

    - condition: template
      value_template: "{{ states(ziel_speaker) in ['off', 'idle', 'unknown', 'unavailable'] }}"

    - variables:
        ziel_volume: >-
          {% if now().hour >= 6 and now().hour < 9 %} 0.25
          {% elif now().hour >= 9 and now().hour < 22 %} 0.35
          {% else %} 0.10 {% endif %}
        gaeste_status: "{{ states('input_select.gastro_mode_guests') }}"
        audio_quelle: "{{ states('input_select.gastro_mode_quelle') }}"
        ordner: >-
          {% if now().hour >= 22 or now().hour < 6 %} nacht
          {% elif gaeste_status == 'Nur wir' %} wir
          {% elif gaeste_status == 'Schweizer Gäste' %} schweizer
          {% elif gaeste_status == 'Französische Gäste' %} french
          {% else %} mixed {% endif %}

    - service: script.gastro_play_and_monitor
      data:
        ausloeser_entity: "{{ ausloeser_entity }}"
        ziel_speaker: "{{ ziel_speaker }}"
        ziel_volume: "{{ ziel_volume }}"
        audio_quelle: "{{ audio_quelle }}"
        ordner: "{{ ordner }}"
        gaeste_status: "{{ gaeste_status }}"

- id: gastro_mode_hard_wächter
  alias: "Gastro-Modus: Sicherheits-Ausschalter Hard-Kill (core_ha_gastromode)"
  description: "Findet chirurgisch genau das EINE WC, in dem das Google Nest hängt, und schaltet es isoliert aus."
  mode: parallel
  max: 10

  trigger:
    - platform: state
      entity_id: script.gastro_play_and_monitor
      to: "on"
      for: "00:20:00"

  action:
    - variables:
        # Sucht den GASTRO-Speaker, der Musik spielt, obwohl sein Bewegungsmelder seit >20 Min auf 'off' steht
        haengender_speaker: >-
          {% set all_gastro = label_entities("GASTRO") | select("match", "^media_player\.") | list %}
          {% set active_speakers = states.media_player | selectattr('entity_id', 'in', all_gastro) | selectattr('state', 'eq', 'playing') | map(attribute='entity_id') | list %}
          {% set target = namespace(speaker=none) %}
          {% for spk in active_speakers %}
            {% set raum = area_id(spk) %}
            {% set sensor = area_entities(raum) | select('match', '^binary_sensor\.') | select('in', label_entities('GASTRO')) | first %}
            {% if sensor is not none and is_state(sensor, 'off') %}
              {% set target.speaker = spk %}
            {% endif %}
          {% endfor %}
          {{ target.speaker }}

    # Wenn kein hängender Raum existiert (z.B. weil jemand echt 20 Min duscht), abbrechen!
    - condition: template
      value_template: "{{ haengender_speaker is not none and haengender_speaker != '' }}"

    # Wir schalten NUR den betroffenen Lautsprecher aus (die Skript-Instanz stirbt danach von selbst)
    - service: media_player.media_stop
      continue_on_error: true
      target:
        entity_id: "{{ haengender_speaker }}"
    - delay: "00:00:02"    
    - service: media_player.media_stop
      continue_on_error: true
      target:
        entity_id: "{{ haengender_speaker }}"
        
    - delay: "00:00:02"    
    - service: media_player.turn_off
      continue_on_error: true
      target:
        entity_id: "{{ haengender_speaker }}"
    - delay: "00:00:02"    
    - service: media_player.turn_off
      continue_on_error: true
      target:
        entity_id: "{{ haengender_speaker }}"

    - service: notify.persistent_notification
      data:
        title: "🛡️ GASTRO GEZIELTER SECURITY KILL"
        message: "Der Lautsprecher '{{ state_attr(haengender_speaker, 'friendly_name') }}' wurde isoliert abgeschaltet. Andere Räume laufen ungestört weiter!"


