template:
  - unique_id: gastro_structure
    binary_sensor:
      - name: "Gastro Sensoren Gruppe"
        unique_id: gastro_sensoren_gruppe
        state: >-
          {% set gastro_entities = label_entities('GASTRO') | select('match', '^binary_sensor\.') | list %}
          {{ states.binary_sensor | selectattr('entity_id', 'in', gastro_entities) | selectattr('state', 'eq', 'on') | list | length > 0 }}
        attributes:
          all_sensors: >-
            {{ label_entities('GASTRO') | select('match', '^binary_sensor\.') | list }}

input_select:
  gastro_mode_guests:
    name: "Gastro-Modus Gästewahl"
    icon: mdi:account-group
    options:
      - "Nur wir"
      - "Schweizer Gäste"
      - "Französische Gäste"
      - "Gemischte Gäste"

# DER NEUE QUELLEN-WÄHLER:
  gastro_mode_quelle:
    name: "Gastro-Modus Audioquelle"
    icon: mdi:music-box-multiple
    options:
      - "Radio Stream"
      - "Lokale MP3-Ordner"

sensor:
  - platform: folder
    folder: /config/www/mp3/_gastromode/wir
  - platform: folder
    folder: /config/www/mp3/_gastromode/schweizer
  - platform: folder
    folder: /config/www/mp3/_gastromode/french
  - platform: folder
    folder: /config/www/mp3/_gastromode/mixed
  - platform: folder
    folder: /config/www/mp3/_gastromode/nacht

automation:
- id: gastro_mode_wc_musik_dynamisch_steuern
  alias: "Gastro-Modus: WC-Musik dynamisch steuern (core_ha_gastromode)"
  description: "Reagiert auf jeden Sensor einzeln, auch wenn in einem anderen WC bereits Musik läuft."
  mode: parallel
  max: 10

  trigger:
    - platform: event
      event_type: state_changed
      id: sensor_event

  condition:
    - condition: template
      value_template: >-
        {% set sensors = state_attr('binary_sensor.gastro_sensoren_gruppe', 'all_sensors') %}
        {{ trigger.event.data.entity_id is defined and sensors is not none and trigger.event.data.entity_id in sensors }}
    - condition: template
      value_template: >-
        {% set old = trigger.event.data.old_state %}
        {% set new = trigger.event.data.new_state %}
        {{ old is not none and new is not none and old.state != new.state }}

  action:
    - variables:
        ausloeser_entity: >-
          {{ trigger.event.data.entity_id if (trigger.event is defined and trigger.event.data is defined) else 'binary_sensor.ms4_occupancy' }}
        neuer_zustand: >-
          {{ trigger.event.data.new_state.state if (trigger.event is defined and trigger.event.data is defined and trigger.event.data.new_state is not none) else 'off' }}

    - variables:
        ziel_raum: "{{ area_id(ausloeser_entity) }}"
        ziel_speaker: >-
          {% if ziel_raum is not none and ziel_raum != '' %}
            {{ area_entities(ziel_raum) | select('match', '^media_player\.') | select('in', label_entities('GASTRO')) | first }}
          {% else %}
            none
          {% endif %}

    - choose:
        # ========================================================================
        # SZENARIO A: SENSOR SCHALTET AUF "ON" (PRÄSENZ ERKANNT)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'on' and ziel_speaker is not none and ziel_speaker != 'none' and ziel_speaker != '' }}"
          sequence:
            - choose:
                - conditions:
                    - condition: template
                      value_template: "{{ states(ziel_speaker) in ['off', 'idle', 'unknown', 'unavailable'] }}"
                  sequence:
                    - service: media_player.turn_on
                      target:
                        entity_id: "{{ ziel_speaker }}"
                    - delay: "00:00:01"

            - choose:
                # FALL 1: DAS HAUS IST SCHARF / PENDING / TRIGGERED -> EINBRECHER-SCHRECK!
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state:
                        - armed_away
                        - armed_home
                        - armed_night
                        - armed_bypass
                        - pending
                        - triggered
                        - arming
                  sequence:
                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: 1.0
                    - service: media_player.play_media
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        # WICHTIG: Tausche ad1000.main.arpa hier gegen die echte Server-IP, falls das Nest stumm bleibt!
                        # ad1000.main.arpa geht mit der IP definitv nicht
                        media_content_id: "http://10.231.9.100:8123/local/mp3/gastromode-einbrecher-toilette-101s.mp3"
                        media_content_type: audio/mp3
                    - service: notify.persistent_notification
                      data:
                        title: "🚨 EINBRUCHSALARM WC!"
                        message: "Präsenz im Raum '{{ area_name(ausloeser_entity) }}' bei scharfer Alarmanlage erkannt!"

                # FALL 2: ALARMANLAGE IST UNSCHARF -> NORMALER GASTRO-MODUS
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state: "disarmed"
                  sequence:
                    - variables:
                        ziel_volume: >
                          {% if now().hour >= 6 and now().hour < 9 %} 0.25
                          {% elif now().hour >= 9 and now().hour < 22 %} 0.35
                          {% else %} 0.10 {% endif %}
                        gaeste_status: "{{ states('input_select.gastro_mode_guests') }}"
                        audio_quelle: "{{ states('input_select.gastro_mode_quelle') }}"

                        # 2. Den exakten Ordnernamen anhand deines Screenshots bestimmen
                    - variables:
                        ordner: >
                          {% if now().hour >= 22 or now().hour < 6 %} nacht
                          {% elif gaeste_status == 'Nur wir' %} wir
                          {% elif gaeste_status == 'Schweizer Gäste' %} schweizer
                          {% elif gaeste_status == 'Französische Gäste' %} french
                          {% else %} mixed {% endif %}

                    # INITIALISIERUNG: Google Nest leise (0.1) einschalten
                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: 0.1

                    - choose:
                        # ----------------------------------------------------------------
                        # WEICHE A: REINER RADIO STREAM (Bleibt unverändert)
                        # ----------------------------------------------------------------
                        - conditions:
                            - condition: template
                              value_template: "{{ audio_quelle == 'Radio Stream' }}"
                          sequence:
                            - variables:
                                radio_url: >
                                  {% if now().hour >= 22 or now().hour < 6 %} https://radio4.vip-radios.fm:18054/stream-128kmp3-BuddhaBeach
                                  {% elif gaeste_status == 'Nur wir' %} https://chmedia.streamabc.net/79-r24-mp3-192-6659699
                                  {% elif gaeste_status == 'Schweizer Gäste' %} http://livestreaming-node-4.srg-ssr.ch/srgssr/rsp/mp3/128
                                  {% elif gaeste_status == 'Französische Gäste' %} http://rcf.streamakaci.com/rcf33.mp3
                                  {% else %} https://0nlineradio.stream13.radiohost.de/lounge-hotel-lounge {% endif %}
                            
                            - service: media_player.play_media
                              target:
                                entity_id: "{{ ziel_speaker }}"
                              data:
                                media_content_id: "{{ radio_url }}"
                                media_content_type: "music"

                            # Normales 20-Sekunden Fade-In für Radio
                            - repeat:
                                count: 20
                                sequence:
                                  - delay: "00:00:01"
                                  - service: media_player.volume_set
                                    target:
                                      entity_id: "{{ ziel_speaker }}"
                                    data:
                                      volume_level: "{{ (0.1 + (repeat.index * ((ziel_volume - 0.1) / 20))) | round(2) if (ziel_volume - 0.1) > 0 else ziel_volume }}"

                        # ----------------------------------------------------------------
                        # WEICHE B: DYNAMISCHE MP3-PLAYLIST (MINIMAL 4 SONGS)
                        # ----------------------------------------------------------------
                        - conditions:
                            - condition: template
                              value_template: "{{ audio_quelle == 'Lokale MP3-Ordner' }}"
                          sequence:
                            # Wir starten eine Schleife, die solange läuft, bis MINDESTENS 4 Songs gespielt wurden 
                            # UND der Bewegungsmelder wieder komplett auf "off" steht.
                            - repeat:
                                until:
                                  - condition: template
                                    value_template: "{{ repeat.index > 6 and is_state(ausloeser_entity, 'off') }}"
                                sequence:
                                  # 1. Neuen Zufallssong ermitteln
                                  - variables:
                                      sensor_id: "sensor.{{ ordner }}"
                                      songs: "{{ state_attr(sensor_id, 'file_list') }}"
                                      zufalls_song: >-
                                        {% if songs is not none and songs | length > 0 %}
                                          {{ (songs | random).split('/') | last }}
                                        {% else %}
                                          none
                                        {% endif %}
                                      media_url: "http://10.231.9.100:8123/local/mp3/_gastromode/{{ ordner }}/{{ zufalls_song | urlencode }}"

                                  # Abbrechen, falls der Ordner leer sein sollte
                                  - condition: template
                                    value_template: "{{ zufalls_song != 'none' }}"

                                  # 2. Song abspielen
                                  - service: media_player.play_media
                                    target:
                                      entity_id: "{{ ziel_speaker }}"
                                    data:
                                      media_content_id: "{{ media_url }}"
                                      media_content_type: "music"

                                  # 3. Nur beim ALLERERSTEN Song der Playlist machen wir das langsame Fade-In
                                  - choose:
                                      - conditions:
                                          - condition: template
                                            value_template: "{{ repeat.index == 1 }}"
                                        sequence:
                                          - repeat:
                                              count: 20
                                              sequence:
                                                - delay: "00:00:01"
                                                - service: media_player.volume_set
                                                  target:
                                                    entity_id: "{{ ziel_speaker }}"
                                                  data:
                                                    volume_level: >-
                                                      {% set schritt = repeat.index %}
                                                      {% set start_vol = 0.1 %}
                                                      {% set differenz = ziel_volume - start_vol %}
                                                      {% if differenz > 0 %}
                                                        {{ (start_vol + (schritt * (differenz / 20))) | round(2) }}
                                                      {% else %}
                                                        {{ ziel_volume }}
                                                      {% endif %}

                                    # Bei Song 2, 3 und 4 bleibt die Lautstärke einfach direkt auf dem Ziel-Level
                                    default:
                                      - service: media_player.volume_set
                                        target:
                                          entity_id: "{{ ziel_speaker }}"
                                        data:
                                          volume_level: "{{ ziel_volume }}"

                                  # 4. DER DYNAMISCHE PLAYLIST-WÄCHTER:
                                  # Wir warten, bis die aktuelle Position die Gesamtlänge des Songs erreicht hat (minus 2 Sekunden für den Übergang).
                                  - delay: >-
                                      {% set dur = state_attr(ziel_speaker, 'media_duration') | float(0) %}
                                      {% if dur > 5 %}
                                        {# Nimmt die Dauer, zieht 2 Sekunden ab und begrenzt auf maximal 360 Sekunden #}
                                        {% set wartezeit = [dur - 2, 360] | min | int %}
                                        {{ wartezeit }}
                                      {% else %}
                                        {# Fallback, falls Google die Dauer im ersten Moment nicht liefert #}
                                        180
                                      {% endif %}

        # ========================================================================
        # SZENARIO B: SENSOR SCHALTET AUF "OFF" (RAUM LEER)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'off' and ziel_speaker is not none and ziel_speaker != 'none' and ziel_speaker != '' }}"
          sequence:
            # WICHTIGER PARSER-FIX: Wir warten allgemein auf ein Event und filtern es sauber im Template!
            - wait_for_trigger:
                - platform: event
                  event_type: state_changed
              timeout: "00:05:00"

            - choose:
                # FALL B1: WC wurde innerhalb der 5 Minuten neu betreten
                - conditions:
                    - condition: template
                      value_template: >-
                        {{ wait.trigger is not none and 
                           wait.trigger.event.data.entity_id == ausloeser_entity and 
                           wait.trigger.event.data.new_state.state == 'on' }}
                  sequence:
                    - stop: "Abbruch, da WC wieder betreten wurde."

                # FALL B2: Raum blieb leer (Timeout abgelaufen) -> Fade-Out startet
                - conditions:
                    - condition: template
                      value_template: "{{ wait.trigger is none or (wait.trigger.event.data.entity_id == ausloeser_entity and wait.trigger.event.data.new_state.state == 'off') }}"
                  sequence:
                    - variables:
                        start_volume_fadeout: "{{ state_attr(ziel_speaker, 'volume_level') | default(0.35) | float }}"

                    - repeat:
                        count: 30
                        sequence:
                          - choose:
                              - conditions:
                                  - condition: template
                                    value_template: "{{ is_state(ausloeser_entity, 'on') }}"
                                sequence:
                                  - stop: "Fade-out abgebrochen, Raum wieder besetzt."
                          
                          - delay: "00:00:01"
                          - service: media_player.volume_set
                            target:
                              entity_id: "{{ ziel_speaker }}"
                            data:
                              volume_level: >-
                                {% set schritt = repeat.index %}
                                {% set aktuelle_stufe = start_volume_fadeout - (schritt * (start_volume_fadeout / 30)) %}
                                {% if aktuelle_stufe > 0.05 %}
                                  {{ aktuelle_stufe | round(2) }}
                                {% else %}
                                  0.01
                                {% endif %}

                    - choose:
                        - conditions:
                            - condition: template
                              value_template: "{{ is_state(ausloeser_entity, 'off') }}"
                          sequence:
                            - service: media_player.media_stop
                              target:
                                entity_id: "{{ ziel_speaker }}"
                            - delay: "00:00:01"
                            - service: media_player.turn_off
                              target:
                                entity_id: "{{ ziel_speaker }}"