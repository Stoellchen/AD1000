# Kommt in die configuration.yaml (falls du Helfer über YAML verwaltest)
input_select:
  gastro_mode_guests:
    name: "Gastro-Modus Gästewahl"
    icon: mdi:account-group
    options:
      - "Nur wir"
      - "Schweizer Gäste"
      - "Französische Gäste"
      - "Gemischte Gäste"



automation:
- id: gastro_mode_wc_musik_dynamisch_steuern
  alias: "Gastro-Modus: WC-Musik dynamisch steuern (core_ha_gastromode)"
  description: "Reagiert auf jeden Sensor einzeln, auch wenn in einem anderen WC bereits Musik läuft."
  mode: parallel # WICHTIG: Erlaubt, dass die Automation für WC 1 und WC 2 GLEICHZEITIG laufen kann!
  max: 10

  trigger:
    # Wir nutzen einen Event-Trigger. Home Assistant feuert dieses Event JEDES MAL,
    # wenn sich IRGENDEIN Zustand im System ändert.
#1    - platform: event
#1      event_type: state_changed
#1      id: sensor_event

    # 1. TEST-AUSLÖSER: Exakt dieser eine Sensor erkennt Präsenz
    - platform: state
      entity_id: binary_sensor.ms4_occupancy
      to: "on"
      id: praesenz_erkannt

    # 2. TEST-AUSLÖSER: Exakt dieser eine Sensor meldet Raum leer
    - platform: state
      entity_id: binary_sensor.ms4_occupancy
      to: "off"
      id: raum_verlassen

  condition:
    # SCHARFER FILTER: Wir lassen das Event NUR durch, wenn die Entität, die sich gerade
    # verändert hat, in der GASTRO-Liste deiner dynamischen Gruppe steht!
#1    - condition: template
#1      value_template: >-
#1        {{ trigger.event.data.entity_id in state_attr('binary_sensor.gastro_sensoren_gruppe', 'all_sensors') }}
    
    # ZUSATZ-FILTER: Wir reagieren nur, wenn sich der ECHTE Zustand (on/off) geändert hat,
    # nicht bei reinen Attribut-Updates (wie z.B. Batterie oder Helligkeit des Sensors).
#1    - condition: template
#1      value_template: >-
#1        {{ trigger.event.data.old_state.state != trigger.event.data.new_state.state }}

  action:
    # Jetzt holen wir uns die Infos direkt aus dem Event, das den Trigger ausgelöst hat
    - variables:
        # 1. Die Entity-ID wird direkt vom auslösenden Sensor geholt
        ausloeser_entity: "binary_sensor.ms4_occupancy"
        
        # 2. Der neue Zustand (on oder off) wird dynamisch ausgelesen
        neuer_zustand: "{{ trigger.to_state.state }}"
        
        # 3. Der Raum wird wie gewohnt über die Entity-ID bestimmt
        ziel_raum: "{{ area_id(ausloeser_entity) }}"

        # HIER DIE FIX-VARIABLE: Findet die passende Media-Player Entität im Raum, die das Label GASTRO hat!
        ziel_speaker: >-
          {{ area_entities(ziel_raum) | select('match', '^media_player\.') | select('in', label_entities('GASTRO')) | first }}

    - choose:
        # ========================================================================
        # SZENARIO A: SENSOR SCHALTET AUF "ON" (PRÄSENZ ERKANNT)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'on' }}"
          sequence:
            - choose:
                # FALL 1: ALARMANLAGE SCHARF -> EINBRECHER-SCHRECK!
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state:
                        - armed_away
                        - armed_home
                        - armed_night
                        - armed_bypass
                  sequence:
                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: 1.0
                    
                    - service: media_player.play_media
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        media_content_id: "http://dein-ha-server:8123/local/audio/alarm_siren.mp3"
                        media_content_type: "music"
                    
                    - service: notify.persistent_notification
                      data:
                        title: "🚨 EINBRUCHSALARM WC!"
                        message: "Präsenz im Raum '{{ area_name(ausloeser_entity) }}' bei scharfer Alarmanlage erkannt!"

                # FALL 2: ALARMANLAGE IST UNSCHARF -> NORMALER GASTRO-MODUS
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state: "disarmed"
                  sequence:
                    - variables:
                        aktuelles_volume: >
                          {% if now().hour >= 6 and now().hour < 9 %} 0.25
                          {% elif now().hour >= 9 and now().hour < 22 %} 0.35
                          {% else %} 0.10 {% endif %}
                        
                        # radio24: https://stream.streambase.ch/radio24/mp3-192/direct/
                        gaeste_status: "{{ states('input_select.gastro_mode_guests') }}"
                        media_url: >
                          {% if now().hour >= 22 or now().hour < 6 %} https://radio4.vip-radios.fm:18054/stream-128kmp3-BuddhaBeach
                          {% elif gaeste_status == 'Nur wir' %} https://chmedia.streamabc.net/79-r24-mp3-192-6659699
                          {% elif gaeste_status == 'Schweizer Gäste' %} 	http://livestreaming-node-4.srg-ssr.ch/srgssr/rsp/mp3/128
                          {% elif gaeste_status == 'Französische Gäste' %} http://rcf.streamakaci.com/rcf33.mp3
                          {% else %} https://0nlineradio.stream13.radiohost.de/lounge-hotel-lounge {% endif %}

                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: "{{ aktuelles_volume }}"

                    - service: media_player.play_media
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        media_content_id: "{{ media_url }}"
                        media_content_type: "music"

        # ========================================================================
        # SZENARIO B: SENSOR SCHALTET AUF "OFF" (RAUM LEER)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'off' }}"
          sequence:
            - delay: "00:05:00"
            - service: media_player.media_stop
              target:
                entity_id: "{{ ziel_speaker }}"



