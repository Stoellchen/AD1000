## füllt die gruppe 'binary_sensor.gastro_sensoren_gruppe' automatisch mit allen Sensoren, die das Label 'GASTRO' besitzen.
template:
  # Der Hauptsensor wird 'on', wenn mindestens ein Sensor aus der GASTRO-Liste 'on' ist
  # Das hier füllt die Liste für deine Automation – garantiert!
  - unique_id: gastro_structure
    binary_sensor:
      - name: "Gastro Sensoren Gruppe"
        unique_id: gastro_sensoren_gruppe
        state: >-
          {% set gastro_entities = label_entities('GASTRO') | select('match', '^binary_sensor\.') | list %}
          {{ states.binary_sensor | selectattr('entity_id', 'in', gastro_entities) | selectattr('state', 'eq', 'on') | list | length > 0 }}
        attributes:
          all_sensors: >-
            {{ label_entities('GASTRO') | select('match', '^binary_sensor\.') | list }}


##
## this must be checked in every send to mobile .....
##
# Kommt in die configuration.yaml (falls du Helfer über YAML verwaltest)
input_select:
  gastro_mode_guests:
    name: "Gastro-Modus Gästewahl"
    icon: mdi:account-group
    options:
      - "Nur wir"
      - "Schweizer Gäste"
      - "Französische Gäste"
      - "Gemischte Gäste"



automation:
- id: gastro_mode_wc_musik_dynamisch_steuern
  alias: "Gastro-Modus: WC-Musik dynamisch steuern (core_ha_gastromode)"
  description: "Reagiert auf jeden Sensor einzeln, auch wenn in einem anderen WC bereits Musik läuft."
  mode: parallel # WICHTIG: Erlaubt, dass die Automation für WC 1 und WC 2 GLEICHZEITIG laufen kann!
  max: 10


  trigger:
    # Wir belauschen das globale System-Event für Zustandsänderungen
    - platform: event
      event_type: state_changed
      id: sensor_event

  condition:
    # 1. SCHARFER TÜRSTEHER: Nur Events durchlassen, wenn die Entity-ID existiert UND in deiner GASTRO-Liste steht
    - condition: template
      value_template: >-
        {% set sensors = state_attr('binary_sensor.gastro_sensoren_gruppe', 'all_sensors') %}
        {{ trigger.event.data.entity_id is defined and sensors is not none and trigger.event.data.entity_id in sensors }}
    
    # 2. SCHUTZ VOR LEEREN ZUSTÄNDEN & ATTRIBUT-UPDATES:
    # Wir stellen sicher, dass sowohl alter als auch neuer Zustand existieren UND sich wirklich unterscheiden (on/off).
    - condition: template
      value_template: >-
        {% set old = trigger.event.data.old_state %}
        {% set new = trigger.event.data.new_state %}
        {{ old is not none and new is not none and old.state != new.state }}

  action:
    - variables:
        # Die Entity-ID direkt aus den Event-Daten extrahieren
        ausloeser_entity: "{{ trigger.event.data.entity_id }}"
        
        # Den neuen Zustand (on oder off) sicher abgreifen
        neuer_zustand: "{{ trigger.event.data.new_state.state }}"
        
        # Den Raum über die Entity-ID bestimmen
        ziel_raum: "{{ area_id(ausloeser_entity) }}"

        # Findet den passenden Media-Player im Raum mit dem Label GASTRO
        ziel_speaker: >-
          {{ area_entities(ziel_raum) | select('match', '^media_player\.') | select('in', label_entities('GASTRO')) | first }}

    - choose:
        # ========================================================================
        # SZENARIO A: SENSOR SCHALTET AUF "ON" (PRÄSENZ ERKANNT)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'on' }}"
          sequence:
            # 1. GOOGLE NEST AUFWECK-LOGIK
            - choose:
                # Falls der Google Nest im Tiefschlaf (off, idle, unknown) ist, schalten wir ihn explizit ein
                - conditions:
                    - condition: template
                      value_template: "{{ states(ziel_speaker) in ['off', 'idle', 'unknown', 'unavailable'] }}"
                  sequence:
                    - service: media_player.turn_on
                      target:
                        entity_id: "{{ ziel_speaker }}"
                    # Ein winziges Delay von 1 Sekunde, damit der Google Nest die Netzwerk-Schnittstelle öffnet
                    - delay: "00:00:01"

            # 2. ALARMANLAGEN-CHECK ODER NORMALBETRIEB
            - choose:
                # FALL 1: DAS HAUS IST SCHARF (ALARMANLAGE AKTIV) -> EINBRECHER-SCHRECK!
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state:
                        - armed_away
                        - armed_home
                        - armed_night
                        - armed_bypass
                        - pending
                  sequence:
                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: 1.0
                    
                    # https://www.naturalreaders.com/online/
                    # Syd ! Lâche immédiatement le chien et prends la barre de fer ! Il y a quelqu'un dans les toilettes invités !
                    # Bonjour. Quel plaisir de vous accueillir ici. Un petit conseil d’ami : il n’y a absolument rien à voler dans ces toilettes – et la police est déjà en route. 
                    # Si vous devez tout de même satisfaire un besoin pressant : merci de ne rien jeter dans la cuvette, nous sommes reliés à une fosse septique très sensible. 
                    # N’oubliez pas de tirer la chasse et de vous comporter correctement, tout comme vous le feriez chez vous. 
                    # À votre place, je détendrais mes jambes et je courrais très, très vite. Excellente journée à vous !
                    - service: media_player.play_media
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        media_content_id: "http://ad1000.main.arpa:8123/local/mp3/gastromode-einbrecher-toilette-101s.mp3"
                        media_content_type: "music"
                    
                    - service: notify.persistent_notification
                      data:
                        title: "🚨 EINBRUCHSALARM WC!"
                        message: "Präsenz im Raum '{{ area_name(ausloeser_entity) }}' bei scharfer Alarmanlage erkannt!"

                # FALL 2: ALARMANLAGE IST UNSCHARF -> NORMALER GASTRO-MODUS
                - conditions:
                    - condition: state
                      entity_id: alarm_control_panel.my_alarm
                      state: "disarmed"
                  sequence:
                    - variables:
                        ziel_volume: >
                          {% if now().hour >= 6 and now().hour < 9 %} 0.25
                          {% elif now().hour >= 9 and now().hour < 22 %} 0.35
                          {% else %} 0.10 {% endif %}

                        gaeste_status: "{{ states('input_select.gastro_mode_guests') }}"
                        media_url: >
                          {% if now().hour >= 22 or now().hour < 6 %} https://radio4.vip-radios.fm:18054/stream-128kmp3-BuddhaBeach
                          {% elif gaeste_status == 'Nur wir' %} https://chmedia.streamabc.net/79-r24-mp3-192-6659699
                          {% elif gaeste_status == 'Schweizer Gäste' %} http://livestreaming-node-4.srg-ssr.ch/srgssr/rsp/mp3/128
                          {% elif gaeste_status == 'Französische Gäste' %} http://rcf.streamakaci.com/rcf33.mp3
                          {% else %} https://0nlineradio.stream13.radiohost.de/lounge-hotel-lounge {% endif %}


                    # 1. Start-Lautstärke sofort auf ganz leise (0.1) setzen
                    - service: media_player.volume_set
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        volume_level: 0.1

                    # Und starten DIREKT danach den Stream
                    - service: media_player.play_media
                      target:
                        entity_id: "{{ ziel_speaker }}"
                      data:
                        media_content_id: "{{ media_url }}"
                        media_content_type: "music"

                    # 3. Das Fade-In: Erhöhe die Lautstärke über 15 Sekunden hinweg
                    # (Wir machen 10 Schritte, alle 1,5 Sekunden einen Schritt)
                    - repeat:
                        count: 20
                        sequence:
                          - delay: "00:00:01" # Warte exakt 1 Sekunde pro Schritt
                          - service: media_player.volume_set
                            target:
                              entity_id: "{{ ziel_speaker }}"
                            data:
                              # Berechnet dynamisch: Start (0.1) + (Schritt-Anzahl * (Differenz / 20))
                              volume_level: >-
                                {% set schritt = repeat.index %}
                                {% set start_vol = 0.1 %}
                                {% set differenz = ziel_volume - start_vol %}
                                {% if differenz > 0 %}
                                  {{ (start_vol + (schritt * (differenz / 20))) | round(2) }}
                                {% else %}
                                  {{ ziel_volume }}
                                {% endif %}

        # ========================================================================
        # SZENARIO B: SENSOR SCHALTET AUF "OFF" (RAUM LEER)
        # ========================================================================
        - conditions:
            - condition: template
              value_template: "{{ neuer_zustand == 'off' }}"
          sequence:
            # 1. INTELLIGENTES WARTEN: Warte bis zu 5 Minuten, ob der Sensor wieder angeht
            - wait_for_trigger:
                - platform: state
                  entity_id: "{{ ausloeser_entity }}"
                  to: "on"
              timeout: "00:05:00"

            # Fällt die Entscheidung: Ist der Timer abgelaufen (True) oder kam jemand rein (False)?
            - choose:
                # FALL B1: Jemand hat das WC innerhalb der 5 Minuten NEU BETRETEN!
                # Wir brechen den Ausschaltprozess hier sofort ab. Die "ON"-Instanz übernimmt bereits.
                - conditions:
                    - condition: template
                      value_template: "{{ wait.trigger is not none }}"
                  sequence:
                    - stop: "Abbruch, da WC wieder betreten wurde."

                # FALL B2: Niemand kam rein (Timeout abgelaufen) -> Jetzt startet das Fade-Out!
                - conditions:
                    - condition: template
                      value_template: "{{ wait.trigger is none }}"
                  sequence:
                    # Aktuelle Lautstärke auslesen
                    - variables:
                        start_volume_fadeout: "{{ state_attr(ziel_speaker, 'volume_level') | default(0.35) | float }}"

                    # 2. Das 30-Sekunden-Fade-Out (mit Live-Überwachung!)
                    - repeat:
                        count: 30
                        sequence:
                          # Wenn WÄHREND der 30 Sekunden jemand reingeht, brechen wir die Schleife ab
                          - choose:
                              - conditions:
                                  - condition: template
                                    value_template: "{{ is_state(ausloeser_entity, 'on') }}"
                                sequence:
                                  # Wir stoppen nicht die Automation, sondern brechen nur das Leiserwerden ab,
                                  # damit die neue "ON"-Instanz das Radio direkt wieder laut stellen kann.
                                  - stop: "Fade-out abgebrochen, Raum wieder besetzt."
                          
                          - delay: "00:00:01" # 1 Sekunde warten pro Schritt
                          - service: media_player.volume_set
                            target:
                              entity_id: "{{ ziel_speaker }}"
                            data:
                              volume_level: >-
                                {% set schritt = repeat.index %}
                                {% set aktuelle_stufe = start_volume_fadeout - (schritt * (start_volume_fadeout / 30)) %}
                                {% if aktuelle_stufe > 0.05 %}
                                  {{ aktuelle_stufe | round(2) }}
                                {% else %}
                                  0.01
                                {% endif %}

                    # 3. LETZTER CHECK: Ist der Raum im exakt selben Moment immer noch leer?
                    - choose:
                        - conditions:
                            - condition: template
                              value_template: "{{ is_state(ausloeser_entity, 'off') }}"
                          sequence:
                            # Erst jetzt Musik stoppen
                            - service: media_player.media_stop
                              target:
                                entity_id: "{{ ziel_speaker }}"
                                
                            # 1 Sekunde Puffer für das Google Nest Netzwerk
                            - delay: "00:00:01"

                            # Endgültig ausschalten
                            - service: media_player.turn_off
                              target:
                                entity_id: "{{ ziel_speaker }}"